<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Four permissions. No INTERNET, no location, no foreground service.
         WRITE_SECURE_SETTINGS cannot be requested by the app: it is granted once
         from a computer with `adb shell pm grant`. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app ask once to be exempt from Doze, so Android does not hold back its
         wake-ups while the phone sits idle. The app does no work while idle. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Phonestick">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PhonestickTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_on"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".WatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Woken by Android when Wi-Fi connects (PendingIntent network callback). -->
        <receiver
            android:name=".NetReceiver"
            android:exported="false" />

        <!-- Lets the companion on the computer switch access on or off over adb.
             Only senders holding WRITE_SECURE_SETTINGS can reach it: the adb shell
             has it, ordinary apps do not. -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="${applicationId}.ARM" />
                <action android:name="${applicationId}.DISARM" />
                <action android:name="${applicationId}.STATUS" />
                <action android:name="${applicationId}.LOG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
