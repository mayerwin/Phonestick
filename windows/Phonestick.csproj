<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10 and 11: a tiny exe, nothing to install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Product name: change here and in AppInfo.cs to rename. -->
    <AssemblyName>Phonestick</AssemblyName>
    <RootNamespace>Phonestick</RootNamespace>
    <Product>Phonestick</Product>
    <Copyright>Erwin Mayer, MIT License</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\phonestick.ico</ApplicationIcon>
    <Version>0.3.10</Version>
    <!-- A single file: no Phonestick.exe.config (.NET Framework 4.8 runs the exe without it). -->
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\*.ico;Assets\*.ttf" LogicalName="Phonestick.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <!-- The phone app is embedded in the exe, so the release is a single file. -->
  <ItemGroup>
    <EmbeddedResource Include="..\android\app\build\outputs\apk\release\app-release.apk"
          LogicalName="Phonestick.Assets.Phonestick.apk"
          Condition="Exists('..\android\app\build\outputs\apk\release\app-release.apk')" />
  </ItemGroup>

</Project>
